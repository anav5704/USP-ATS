model Profile {
  id           String       @id @default(cuid())
  userId       String       @unique
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone        String?
  bio          String?
  skills       String[]
  campuses     String[]     @default([])
  degrees      Degree[]
  certificates Certificate[]
  socialLinks  SocialLink[]
  profileLinks ProfileLink[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("profile")
}

model Degree {
  id           String       @id @default(cuid())
  profileId    String
  profile      Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name         String
  gpa          Decimal      @db.Decimal(3, 2)
  documentType DocumentType @default(TRANSCRIPT)
  fileName     String
  stored       String
  type         String
  size         Int
  uploadedAt   DateTime     @default(now())

  @@index([profileId])
  @@map("degree")
}

model Certificate {
  id           String   @id @default(cuid())
  profileId    String
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  label        String
  organization String?
  url          String?
  name         String
  stored       String
  type         String
  size         Int
  uploadedAt   DateTime @default(now())

  @@index([profileId])
  @@map("certificate")
}

model SocialLink {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  platform  String
  url       String

  @@index([profileId])
  @@map("social_link")
}

model ProfileLink {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title     String
  url       String

  @@index([profileId])
  @@map("profile_link")
}

enum DocumentType {
  TRANSCRIPT
  DEGREE
}
